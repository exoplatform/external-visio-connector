<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>addons-exo-parent-pom</artifactId>
    <groupId>org.exoplatform.addons</groupId>
    <version>21-M02</version>
  </parent>

  <groupId>org.exoplatform.addons.external-visio-connector</groupId>
  <artifactId>external-visio-connector</artifactId>
  <version>7.3.x-maintenance-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>eXo Add-on:: eXo External Visio Connector</name>
  <description>eXo Web Conferencing portal extension</description>
  <properties>
    <!-- Java 25: compile for and against Java 25, with the tools that read its class files -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <maven.compiler.release>25</maven.compiler.release>
    <version.jacoco.plugin>0.8.14</version.jacoco.plugin>
    <plugin.aspectj.version>1.16.1</plugin.aspectj.version>
    <org.aspectj.version>1.9.25.1</org.aspectj.version>
    <org.lombok.version>1.18.46</org.lombok.version>
    <addon.exo.web-conferencing.version>7.3.x-maintenance-SNAPSHOT</addon.exo.web-conferencing.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.exoplatform.addons.web-conferencing</groupId>
        <artifactId>web-conferencing</artifactId>
        <version>${addon.exo.web-conferencing.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>external-visio-connector-services</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>external-visio-connector-webapp</artifactId>
        <version>${project.version}</version>
        <type>war</type>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>external-visio-connector-packaging</artifactId>
        <version>${project.version}</version>
        <type>zip</type>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <modules>
    <module>services</module>
    <module>webapp</module>
    <module>packaging</module>
  </modules>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- Since JDK 23, javac runs an annotation processor found on the class path, such as Lombok, only when asked to -->
            <proc>full</proc>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
